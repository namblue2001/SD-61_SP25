@model IEnumerable<StyleTee.Models.TaiKhoan>
@{
    ViewData["Title"] = "Danh sách khách hàng";
    Layout = "~/Areas/QuanLy/Views/Shared/_LayoutQuanLy.cshtml";
    List<string> imageExtension = new() { ".jpg", ".png", ".webp", ".gif", ".jpeg" };
}
<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6>Danh sách khách hàng</h6>
                    <a asp-action="Create" class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i> Thêm khách hàng mới
                    </a>
                </div>
                <div class="card-body px-0 pt-0 pb-2">
                    <div class="table-responsive p-0">
                        <table class="table align-items-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Tên đăng nhập</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Họ tên</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Email</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Số điện thoại</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Ảnh đại diện</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Giới tính</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Ngày sinh</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Trạng thái</th>
                                    <th class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7 ps-2">Vai trò</th>
                                    <th class="text-secondary opacity-7"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.taiKhoan</p>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.hoTen</p>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.email</p>
                                        </td>

                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.soDienThoai</p>
                                        </td>
                                        <td>
                                            @{
                                                // Lấy đuôi của ảnh để check xem có phải ảnh hay ko?
                                                var extension = System.IO.Path.GetExtension(item.anhDaiDien);
                                            }
                                            @if (imageExtension.Contains(extension)) // Check đuôi ảnh
                                            {
                                                <img src="~/LayoutAdmin/img/NhanVien/@item.anhDaiDien" height="100px">
                                                // Gán ảnh
                                            }
                                            else // Nếu không đúng ta set 1 ảnh mặc định
                                            {
                                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR4v_dkWPQi1loWthMLDpIYa587pwZ6KWz9SdQ6FakvnSLrYK03I7MyqWimrkVntTXNxE0&usqp=CAU" height="100">
                                            }
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.gioiTinh</p>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.ngaySinh</p>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.trangThai</p>
                                        </td>
                                        <td>
                                            <p class="text-xs font-weight-bold mb-0">@item.tenVaiTro</p>
                                        </td>

                                        <td class="align-middle">
                                            <a asp-action="Edit" asp-route-id="@item.ID_TaiKhoan" class="btn btn-green btn-sm text-secondary">
                                                Sửa
                                            </a>
                                            <a asp-action="Details" asp-route-id="@item.ID_TaiKhoan" class="btn btn-yellow btn-sm text-secondary ">
                                                Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
