@model StyleTee.Models.TaiKhoan

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Areas/QuanLy/Views/Shared/_LayoutQuanLy.cshtml";
    List<string> extensions = new List<string>() { ".jpg", ".png", ".tiff", ".gif", "jpeg" };
}

<div class="row my-4">
    <div class="col-lg-8 col-md-6 mb-md-0 mb-4">
        <div class="card">
            <div class="card-header pb-0">
                <div class="row">
                    <div class="col-lg-6 col-7">
                        <h6><i class=""></i> Chi tiết nhân viên</h6>
                    </div>
                    <div class="col-lg-6 col-5 my-auto text-end">
                        <div class="dropdown float-lg-end">
                            <a class="btn btn-primary" asp-action="Index"><i class="fas fa-list"></i> Trở về danh sách</a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" asp-route-id="@Model.ID_TaiKhoan" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ID_TaiKhoan" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row">
                            <dt class="col-sm-3 fw-bold">Mã nhân viên</dt>
                            <dd class="col-sm-9 small">@Model.ID_TaiKhoan</dd>

                            <dt class="col-sm-3 fw-bold">Họ và tên</dt>
                            <dd class="col-sm-9 small">@Model.hoTen</dd>

                            <dt class="col-sm-3 fw-bold">Tài khoản</dt>
                            <dd class="col-sm-9 small">@Model.taiKhoan</dd>

                            <dt class="col-sm-3 fw-bold">Email</dt>
                            <dd class="col-sm-9 small">@Model.email</dd>

                            <dt class="col-sm-3 fw-bold">Số điện thoại</dt>
                            <dd class="col-sm-9 small">@Model.soDienThoai</dd>

                            <dt class="col-sm-3 fw-bold">Giới tính</dt>
                            <dd class="col-sm-9 small">@Model.gioiTinh</dd>

                            <dt class="col-sm-3 fw-bold">Ngày sinh</dt>
                            <dd class="col-sm-9 small">@Model.ngaySinh.ToString("dd/MM/yyyy")</dd>

                            <dt class="col-sm-3 fw-bold">Trạng thái</dt>
                            <dd class="col-sm-9 small">@Model.trangThai</dd>

                            <dt class="col-sm-3 fw-bold">Ảnh đại diện</dt>
                            <dd class="col-sm-9 small">
                                @if (!string.IsNullOrEmpty(Model.anhDaiDien))
                                {
                                    <img src="~/Image/@Model.anhDaiDien" class="img-thumbnail" style="max-width: 150px; max-height: 150px;" alt="Ảnh đại diện" />
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có ảnh đại diện</span>
                                }
                            </dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="card h-100">
            <div class="card-header pb-0">
                <h6><i class=""></i> Sửa thông tin nhân viên</h6>
            </div>
            <div class="card-body p-3">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Chỉ nhập những thông tin muốn thay đổi. Các trường để trống sẽ giữ nguyên giá trị cũ.
                </div>
                <div class="table-responsive">
                    <form asp-action="Edit" method="post" class="container" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-sm text-danger"></div>
                        <input type="hidden" asp-for="ID_TaiKhoan" />
                        <input type="hidden" asp-for="tenVaiTro" value="Nhân Viên" />
                        <input type="hidden" asp-for="anhDaiDien" />

                        <div class="form-group">
                            <label class="control-label">Họ và tên</label>
                            <input asp-for="hoTen" class="form-control" placeholder="Nhập họ và tên mới (nếu muốn thay đổi)" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi</small>
                            <span asp-validation-for="hoTen" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Tài khoản</label>
                            <input asp-for="taiKhoan" class="form-control" placeholder="Nhập tài khoản mới (nếu muốn thay đổi)" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi</small>
                            <span asp-validation-for="taiKhoan" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Mật khẩu</label>
                            <input asp-for="matKhau" class="form-control" type="password" placeholder="Nhập mật khẩu mới (nếu muốn thay đổi)" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi mật khẩu</small>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Email</label>
                            <input asp-for="email" class="form-control" placeholder="Nhập email mới (nếu muốn thay đổi)" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi</small>
                            <span asp-validation-for="email" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Số điện thoại</label>
                            <input asp-for="soDienThoai" class="form-control" placeholder="Nhập số điện thoại mới (nếu muốn thay đổi)" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi</small>
                            <span asp-validation-for="soDienThoai" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Giới tính</label>
                            <select asp-for="gioiTinh" class="form-control">
                                <option value="">Giữ nguyên</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                            <small class="form-text text-muted">Chọn "Giữ nguyên" nếu không muốn thay đổi</small>
                            <span asp-validation-for="gioiTinh" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Ngày sinh</label>
                            <input asp-for="ngaySinh" class="form-control" type="date" />
                            <small class="form-text text-muted">Để trống nếu không muốn thay đổi</small>
                            <span asp-validation-for="ngaySinh" class="text-sm text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="control-label">Trạng thái</label>
                            <select asp-for="trangThai" class="form-control">
                                <option value="Hoạt động">Hoạt động</option>
                                <option value="Ngừng hoạt động">Ngừng hoạt động</option>
                            </select>

                            <small class="form-text text-muted">Chỉ chọn nếu muốn thay đổi trạng thái</small>
                            <span asp-validation-for="trangThai" class="text-sm text-danger"></span>

                        </div>

                        <div class="form-group">
                            <label class="control-label">Ảnh đại diện</label>
                            @if (!string.IsNullOrEmpty(Model.anhDaiDien))
                            {
                                <div class="mb-2">
                                    <img src="~/Image/@Model.anhDaiDien" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" alt="Ảnh hiện tại" />
                                    <small class="form-text text-muted d-block">Ảnh hiện tại</small>
                                </div>
                            }
                            <div class="custom-file">
                                <input type="file" name="imageFile" class="form-control" accept=".jpg,.jpeg,.png,.gif" id="imageFile" onchange="previewImage(this);" />
                                <small class="form-text text-muted">Chỉ chọn file nếu muốn thay đổi ảnh đại diện</small>
                            </div>
                            <div class="form-group mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="fas fa-save"></i> Cập nhật nhân viên
                                </button>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function previewImage(input) {
            var preview = document.getElementById('preview');
            var previewDiv = document.getElementById('imagePreview');

            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    previewDiv.style.display = 'block';
                }

                reader.readAsDataURL(input.files[0]);
            } else {
                preview.src = '';
                previewDiv.style.display = 'none';
            }
        }
    </script>
} 