@model StyleTee.Models.TaiKhoan
@{
    ViewData["Title"] = "Chi tiết thông tin nhân viên";
    Layout = "~/Areas/QuanLy/Views/Shared/_LayoutQuanLy.cshtml";
}
<div class="card mb-4">
    <div class="card-header">
        <h3> Xin chào @Model.hoTen</h3>  <dd class="col-sm-9">
            @if (!string.IsNullOrEmpty(Model.anhDaiDien))
            {
                <img src="~/Image/@Model.anhDaiDien" alt="Ảnh đại diện" height="100px" />
            }
            else
            {
                <p>Không có ảnh đại diện.</p>
            }
        </dd>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID: </dt>
            <dd class="col-sm-9">@Model.ID_TaiKhoan</dd>

            <dt class="col-sm-3">Tên đăng nhập: </dt>
            <dd class="col-sm-9">@Model.taiKhoan</dd>

            <dt class="col-sm-3">Mật khẩu: </dt>
            <dd class="col-sm-9">@Model.matKhau</dd>

            <dt class="col-sm-3">Email: </dt>
            <dd class="col-sm-9">@Model.email</dd>

            <dt class="col-sm-3">Họ tên: </dt>
            <dd class="col-sm-9">@Model.hoTen</dd>

            <dt class="col-sm-3">Số điện thoại: </dt>
            <dd class="col-sm-9">@Model.soDienThoai</dd>

            <dt class="col-sm-3">Giới tính: </dt>
            <dd class="col-sm-9">@Model.gioiTinh</dd>

            <dt class="col-sm-3">Ngày sinh: </dt>
            <dd class="col-sm-9">@Model.ngaySinh</dd>

            <dt class="col-sm-3">Trạng thái: </dt>
            <dd class="col-sm-9">@Model.trangThai</dd>

            <dt class="col-sm-3">Vai trò: </dt>
            <dd class="col-sm-9">@Model.tenVaiTro</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.ID_TaiKhoan" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
