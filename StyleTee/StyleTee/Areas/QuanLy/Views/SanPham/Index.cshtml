@model IEnumerable<StyleTee.Models.SanPham>

@{
    ViewData["Title"] = "Index";
    List<string> extensions = new List<string>() { ".jpg", ".png", ".tiff", ".gif", "jpeg" };
}

<div class="row my-4">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h6><i class="fas fa-search"></i> Tìm kiếm sản phẩm</h6>
                <form asp-action="Index" method="post" class="d-flex" role="search">
                    <input class="form-control me-2" name="ten" type="search" placeholder="Nhập tên..." aria-label="Search" required>
                    <button class="badge bg-success" type="submit">Tìm</button>
                </form>
            </div>
            <div class="card-body px-0 pt-0 pb-2">
                <div class="table-responsive p-0">

                </div>
            </div>
        </div>
    </div>
</div>

<div class="row my-4">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h6><i class="fas fa-box"></i> Danh sách sản phẩm</h6>
                <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus"></i> Thêm mới sản phẩm</a>
            </div>
            <div class="card-body px-0 pt-0 pb-2">
                <div class="table-responsive p-0">
                    <table class="table table-hover align-items-center mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="text-center">STT</th>
                                <th scope="col" class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thông tin sản phẩm</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Trạng thái</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Ngày tạo</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
                            {
                                <tr>
                                    <td scope="row" class="text-sm text-center">@(index + 1)</td>
                                    <td>
                                        <div class="d-flex px-2 py-1">
                                            <div>
                                                @{
                                                    var extension = System.IO.Path.GetExtension(item.AnhDaiDien);
                                                }
                                                @if (@extensions.Contains(extension))
                                                {
                                                    <img src="~/LayoutAdmin/img/SanPham/@item.AnhDaiDien" class="avatar avatar-lg me-3" alt="user1">
                                                }
                                            </div>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-sm">@item.tenSanPham</h6>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle text-center text-sm">
                                        @if (item.trangThai == "Hoạt động")
                                        {
                                            <span class="badge bg-gradient-success">@item.trangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-gradient-secondary">@item.trangThai</span>
                                        }
                                    </td>
                                    <td class="text-sm align-middle text-center">
                                        @Html.DisplayFor(modelItem => item.NgayTao)
                                    </td>
                                    <td class="align-middle text-center">
                                        <a class="badge badge-sm bg-gradient-warning me-2 text-light font-weight-bold text-xs" asp-action="Edit" asp-route-id="@item.ID_SanPham"><i class="fas fa-edit"></i> Chi tiết && chỉnh sửa</a>
                                        <a class="badge badge-sm bg-gradient-info text-light font-weight-bold text-xs" asp-action="SanPhamChiTiet" asp-route-id="@item.ID_SanPham"><i class="fas fa-info-circle"></i> Sản phẩm chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
