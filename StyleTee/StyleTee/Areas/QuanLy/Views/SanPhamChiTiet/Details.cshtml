@model StyleTee.Models.SanPhamChiTiet

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0">
                    <h6>Chi tiết sản phẩm</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">Sản phẩm</label>
                                <p class="form-control-static">@Model.SanPham?.tenSanPham</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Màu sắc</label>
                                <p class="form-control-static">@Model.MauSac?.tenMauSac</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Xuất xứ</label>
                                <p class="form-control-static">@Model.XuatXu?.tenXuatXu</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Thương hiệu</label>
                                <p class="form-control-static">@Model.ThuongHieu?.tenThuongHieu</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="control-label">Size</label>
                                <p class="form-control-static">@Model.KichThuoc?.tenKichThuoc</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Kiểu dáng</label>
                                <p class="form-control-static">@Model.KieuDang?.tenKieuDang</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Chất liệu</label>
                                <p class="form-control-static">@Model.ChatLieu?.tenChatLieu</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Giá bán</label>
                                <p class="form-control-static">@Model.giaBan.ToString("N0") VNĐ</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Số lượng</label>
                                <p class="form-control-static">@Model.soLuongTon</p>
                            </div>

                            <div class="form-group">
                                <label class="control-label">Ảnh đại diện</label>
                                @if (!string.IsNullOrEmpty(Model.anhDaiDien))
                                {
                                    <div class="mt-2">
                                        <img src="~/LayoutAdmin/img/SanPhamChiTiet/@Model.anhDaiDien" class="img-thumbnail" style="max-width: 200px;" />
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.ID_SanPhamChiTiet" class="btn btn-primary">Chỉnh sửa</a>
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
