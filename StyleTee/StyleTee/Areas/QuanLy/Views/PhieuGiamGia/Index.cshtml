@model IEnumerable<StyleTee.Models.PhieuGiamGiaVaKhuyenMai.PhieuGiamGia>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center">
    <ul class="nav nav-pills mx-auto" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active btn btn-info tabcss" id="pills-home-tab" data-bs-toggle="pill" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Phiếu giảm giá</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link btn btn-success tabcss" id="pills-profile-tab" data-bs-toggle="pill" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false">Khuyến mãi sản phẩm</button>
        </li>
    </ul>
</div>

<div class="tab-content" id="pills-tabContent">
    <div class="tab-pane fade show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab" tabindex="0">
        <div class="row my-4">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h6><i class="fas fa-search"></i> Tìm kiếm phiếu giảm giá</h6>
                        <form asp-action="Index" method="post" class="d-flex" role="search">
                            <input class="form-control me-2" name="ten" type="search" placeholder="Nhập tên..." aria-label="Search" required>
                            <button class="badge bg-success" type="submit">Tìm</button>
                        </form>
                    </div>
                    <div class="card-body px-0 pt-0 pb-2">
                        <div class="table-responsive p-0">

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row my-4">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h6><i class="fas fa-tags"></i> Danh sách phiếu giảm giá</h6>
                        <a class="btn btn-primary" asp-action="Create"><i class="fas fa-plus"></i> Thêm mới phiếu giảm giá</a>
                    </div>
                    <div class="card-body px-0 pt-0 pb-2">
                        <div class="table-responsive p-0">
                            <table class="table table-hover align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col" class="text-center">STT</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Tên phiếu giảm giá</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Loại giảm giá</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Giá trị</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Ngày bắt đầu</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Ngày kết thúc</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Giá trị đơn hàng tối thiểu</th>
                                        <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
                                    {
                                        <tr>
                                            <td scope="row" class="text-sm text-center">@(index + 1)</td>
                                            <td class="text-sm align-middle text-center">
                                                @item.TenPhieuGiamGia
                                            </td>
                                            <td class="text-sm align-middle text-center">
                                                @item.LoaiGiamGia
                                            </td>
                                            <td class="text-sm align-middle text-center">
                                                @item.GiaTriKhuyenMai
                                            </td>
                                            <td class="text-sm align-middle text-center">
                                                @item.NgayBatDau
                                            </td>
                                            <td class="text-sm align-middle text-center">
                                                @item.NgayHetHan
                                            </td>
                                            <td class="text-sm align-middle text-center">
                                                @item.GiaTriDonHangToiThieu
                                            </td>
                                            <td class="align-middle text-center">
                                                <a class="badge badge-sm bg-gradient-warning me-2 text-light font-weight-bold text-xs" asp-action="Edit" asp-route-id="@item.Ma_PhieuGiamGia"><i class="fas fa-edit"></i> Sửa</a>
                                                <a class="badge badge-sm bg-gradient-info text-light font-weight-bold text-xs" asp-action="Details" asp-route-id="@item.Ma_PhieuGiamGia"><i class="fas fa-info-circle"></i> Chi tiết</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
