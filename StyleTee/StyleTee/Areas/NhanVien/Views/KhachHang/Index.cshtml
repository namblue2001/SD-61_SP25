@model IEnumerable<TaiKhoan>

@{
    ViewData["Title"] = "Index";
    List<string> extensions = new List<string>() { ".jpg", ".png", ".tiff", ".gif", "jpeg" };
}

<div class="row my-4">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h6><i class="fas fa-search"></i> Tìm kiếm khách hàng</h6>
                <form asp-action="Index" method="post" class="d-flex" role="search">
                    <input class="form-control me-2" name="ten" type="search" placeholder="Nhập tên..." aria-label="Search">
                    <button class="badge bg-success" type="submit">Tìm</button>
                </form>
            </div>
            <div class="card-body px-0 pt-0 pb-2">
                <div class="table-responsive p-0">

                </div>
            </div>
        </div>
    </div>
</div>

<div class="row my-4">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                <h6><i class="fas fa-users"></i> Danh sách khách hàng</h6>
            </div>
            <div class="card-body px-0 pt-0 pb-2">
                <div class="table-responsive p-0">
                    <table class="table table-hover align-items-center mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="text-center">STT</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Tài khoản</th>
                                <th scope="col" class="text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thông tin khách hàng</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Số điện thoại</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Trạng thái</th>
                                <th scope="col" class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (item, index) in Model.Select((item, index) => (item, index)))
                            {
                                <tr>
                                    <td scope="row" class="text-sm text-center">@(index + 1)</td>
                                    <td class="text-sm align-middle text-center">
                                        @item.taiKhoan
                                    </td>
                                    <td>
                                        <div class="d-flex px-2 py-1">
                                            <div>
                                                @{
                                                    var extension = System.IO.Path.GetExtension(item.anhDaiDien);
                                                }
                                                @if (@extensions.Contains(extension))
                                                {
                                                    <img src="~/LayoutAdmin/img/KhachHang/@item.anhDaiDien" class="avatar avatar-sm me-3" alt="user1">
                                                }
                                                else
                                                {
                                                    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRxXNZL0tK1RVwlcZtKQLxxAro4UKbPH0m_Iw&s" class="avatar avatar-sm me-3" alt="user1">
                                                }
                                            </div>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="mb-0 text-sm">@item.hoTen</h6>
                                                <p class="text-xs text-secondary mb-0">@item.email</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-sm align-middle text-center">
                                        @Html.DisplayFor(modelItem => item.soDienThoai)
                                    </td>
                                    <td class="align-middle text-center text-sm">
                                        @if (item.trangThai == "Hoạt động")
                                        {
                                            <span class="badge bg-gradient-success">@item.trangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-gradient-secondary">@item.trangThai</span>
                                        }
                                    </td>
                                    <td class="align-middle text-center">
                                        <a class="badge badge-sm bg-gradient-info text-light font-weight-bold text-xs" asp-action="Details" asp-route-id="@item.ID_TaiKhoan"><i class="fas fa-info-circle"></i> Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
