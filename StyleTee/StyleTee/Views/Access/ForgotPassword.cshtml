@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h5 class="mb-0"><i class="fas fa-key me-2"></i>Quên mật khẩu</h5>
                </div>

                <div class="card-body px-4 pt-4 pb-4">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success text-center">@ViewBag.Success</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger text-center">@ViewBag.Error</div>
                    }

                    <form method="post" novalidate>
                        <div class="form-group mb-3">
                            <label for="email" class="form-label">📧 Email:</label>
                            <input type="email" name="email" class="form-control form-control-lg rounded-3" placeholder="Nhập email của bạn..." required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-3">
                            <i class="fas fa-paper-plane me-1"></i> Gửi mật khẩu
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-area="" asp-controller="Access" asp-action="DangNhap" class="text-decoration-none text-primary fw-semibold">
                            <i class="fas fa-arrow-left me-1"></i>Quay lại đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
