@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">🔑 Quên mật khẩu</h2>

    @if (ViewBag.Success != null)
    {
        <div class="alert alert-success text-center">@ViewBag.Success</div>
    }
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger text-center">@ViewBag.Error</div>
    }

    <form method="post" class="p-4 shadow bg-white rounded">
        <div class="form-group">
            <label for="email">Nhập email của bạn:</label>
            <input type="email" name="email" class="form-control" placeholder="Nhập email" required />
        </div>
        <button type="submit" class="btn btn-primary btn-block">Gửi mật khẩu</button>
    </form>

    <div class="text-center mt-3">
        <a href="/Access/DangNhap">🔙 Quay lại đăng nhập</a>
    </div>
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .container {
        max-width: 450px;
    }

    .shadow {
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }
</style>
