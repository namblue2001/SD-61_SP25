@model IEnumerable<StyleTee.Models.SanPham>
@{
    ViewData["Title"] = "Privacy";
    Layout = "~/Views/Shared/_LayoutTrangChuKhachHang.cshtml";
}

<div class="row margin-bottom-40">
    <!-- BEGIN SALE PRODUCT -->
    <div class="col-md-12 sale-product">
        <h2>New Arrivals</h2>
        <div class="owl-carousel owl-carousel5">
            @foreach (var product in Model ?? Enumerable.Empty<SanPham>())
            {
                if (product != null && !string.IsNullOrEmpty(product.tenSanPham))
                {
                    <div>
                        <div class="product-item">
                            <div class="pi-img-wrapper">
                                @if (!string.IsNullOrEmpty(product.anhDaiDien))
                                {
                                    <img src="@Url.Content(product.anhDaiDien)" class="img-responsive" alt="@product.tenSanPham">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/products/model1.jpg")" class="img-responsive" alt="@product.tenSanPham">
                                }
                                <div>
                                    <a href="@Url.Content(!string.IsNullOrEmpty(product.anhDaiDien) ? product.anhDaiDien : "~/LayoutKhachHang/assets/pages/img/products/model1.jpg")" class="btn btn-default fancybox-button">Zoom</a>
                                    <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })" class="btn btn-default fancybox-fast-view">View</a>
                                </div>
                            </div>
                            <h3><a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">@product.tenSanPham</a></h3>
                            <div class="pi-price">@product.giaGoc.ToString("N0") đ</div>
                            <a href="javascript:;" class="btn btn-default add2cart">Add to cart</a>
                            <div class="sticker sticker-sale"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <!-- END SALE PRODUCT -->
</div>

<!-- BEGIN SIDEBAR & CONTENT -->
<div class="row margin-bottom-40">
    <!-- BEGIN SIDEBAR -->
    <div class="sidebar col-md-3 col-sm-4">
        <ul class="list-group margin-bottom-25 sidebar-menu">
            @{
                var categories = (Model ?? Enumerable.Empty<SanPham>())
                .Where(p => p?.DanhMuc != null)
                .Select(p => p.DanhMuc)
                .Distinct();

                foreach (var category in categories)
                {
                    if (category != null && !string.IsNullOrEmpty(category.tenDanhMuc))
                    {
                        <li class="list-group-item clearfix">
                            <a href="@Url.Action("Privacy", "Home", new { categoryId = category.ID_DanhMuc })">
                                <i class="fa fa-angle-right"></i> @category.tenDanhMuc
                            </a>
                        </li>
                    }
                }
            }
        </ul>
    </div>
    <!-- END SIDEBAR -->
    <!-- BEGIN CONTENT -->
    <div class="col-md-9 col-sm-8">
        <h2>Three items</h2>
        <div class="owl-carousel owl-carousel3">
            @foreach (var product in (Model ?? Enumerable.Empty<SanPham>()).Take(6))
            {
                if (product != null && !string.IsNullOrEmpty(product.tenSanPham))
                {
                    <div>
                        <div class="product-item">
                            <div class="pi-img-wrapper">
                                @if (!string.IsNullOrEmpty(product.anhDaiDien))
                                {
                                    <img src="@Url.Content(product.anhDaiDien)" class="img-responsive" alt="@product.tenSanPham">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/products/k1.jpg")" class="img-responsive" alt="@product.tenSanPham">
                                }
                                <div>
                                    <a href="@Url.Content(!string.IsNullOrEmpty(product.anhDaiDien) ? product.anhDaiDien : "~/LayoutKhachHang/assets/pages/img/products/k1.jpg")" class="btn btn-default fancybox-button">Zoom</a>
                                    <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })" class="btn btn-default fancybox-fast-view">View</a>
                                </div>
                            </div>
                            <h3><a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">@product.tenSanPham</a></h3>
                            <div class="pi-price">@product.giaGoc.ToString("N0") đ</div>
                            <a href="javascript:;" class="btn btn-default add2cart">Add to cart</a>
                            <div class="sticker sticker-sale"></div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <!-- END CONTENT -->
</div>
<!-- END SIDEBAR & CONTENT -->
<!-- BEGIN TWO PRODUCTS & PROMO -->
<div class="row margin-bottom-35">
    <!-- BEGIN TWO PRODUCTS -->
    <div class="col-md-6 two-items-bottom-items">
        <h2>Two items</h2>
        <div class="owl-carousel owl-carousel2">
            @foreach (var product in (Model ?? Enumerable.Empty<SanPham>()).Take(6))
            {
                if (product != null && !string.IsNullOrEmpty(product.tenSanPham))
                {
                    <div>
                        <div class="product-item">
                            <div class="pi-img-wrapper">
                                @if (!string.IsNullOrEmpty(product.anhDaiDien))
                                {
                                    <img src="@Url.Content(product.anhDaiDien)" class="img-responsive" alt="@product.tenSanPham">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/products/k4.jpg")" class="img-responsive" alt="@product.tenSanPham">
                                }
                                <div>
                                    <a href="@Url.Content(!string.IsNullOrEmpty(product.anhDaiDien) ? product.anhDaiDien : "~/LayoutKhachHang/assets/pages/img/products/k4.jpg")" class="btn btn-default fancybox-button">Zoom</a>
                                    <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })" class="btn btn-default fancybox-fast-view">View</a>
                                </div>
                            </div>
                            <h3><a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">@product.tenSanPham</a></h3>
                            <div class="pi-price">@product.giaGoc.ToString("N0") đ</div>
                            <form method="post" asp-action="AddToCart" asp-controller="GioHang">
                                <input type="hidden" name="idSanPham" value="@product.ID_SanPham" />
                                <input type="hidden" name="tenSanPham" value="@product.tenSanPham" />
                                <input type="hidden" name="anhDaiDien" value="@product.anhDaiDien" />
                                <input type="hidden" name="donGia" value="@product.giaGoc" />
                                <input type="number" name="soLuong" value="1" min="1" />
                                <button type="submit" class="btn btn-primary">Thêm vào giỏ hàng</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <!-- END TWO PRODUCTS -->
    <!-- BEGIN PROMO -->
    <div class="col-md-6 shop-index-carousel">
        <div class="content-slider">
            <div id="myCarousel" class="carousel slide" data-ride="carousel">
                <!-- Indicators -->
                <ol class="carousel-indicators">
                    <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                    <li data-target="#myCarousel" data-slide-to="1"></li>
                    <li data-target="#myCarousel" data-slide-to="2"></li>
                </ol>
                <div class="carousel-inner">
                    <div class="item active">
                        <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/index-sliders/slide1.jpg")" class="img-responsive" alt="Berry Lace Dress">
                    </div>
                    <div class="item">
                        <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/index-sliders/slide2.jpg")" class="img-responsive" alt="Berry Lace Dress">
                    </div>
                    <div class="item">
                        <img src="@Url.Content("~/LayoutKhachHang/assets/pages/img/index-sliders/slide3.jpg")" class="img-responsive" alt="Berry Lace Dress">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- END PROMO -->
</div>
<!-- END TWO PRODUCTS & PROMO -->

