@model TaiKhoan

@{
    ViewData["Title"] = "HoSoQuanLy";
    Layout = "~/Areas/QuanLy/Views/Shared/_LayoutQuanLy.cshtml";
}

<div class="container-fluid">
    <div class="page-header min-height-300 border-radius-xl mt-4" style="background-image: url('../../LayoutAdmin/assets/img/curved-images/curved0.jpg'); background-position-y: 50%;">
        <span class="mask bg-gradient-primary opacity-6"></span>
    </div>
    <div class="card card-body blur shadow-blur mx-4 mt-n6 overflow-hidden">
        <div class="row gx-4">
            <div class="col-auto">
                <div class="avatar avatar-xl position-relative">
                    @if (Model.anhDaiDien == null)
                    {
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRxXNZL0tK1RVwlcZtKQLxxAro4UKbPH0m_Iw&s" alt="profile_image" class="w-100 border-radius-lg shadow-sm">
                    }
                    else
                    {
                        <img src="../../LayoutAdmin/assets/img/@Model.anhDaiDien" alt="profile_image" class="w-100 border-radius-lg shadow-sm">
                    }
                </div>
            </div>
            <div class="col-auto my-auto">
                <div class="h-100">
                    <h5 class="mb-1">
                        @Model.hoTen
                    </h5>
                    <p class="mb-0 font-weight-bold text-sm">
                        @Model.tenVaiTro
                    </p>
                </div>                        
            </div>
        </div>
    </div>
    <div class="row my-4">
        <div class="col-12">
            <div class="card mb-4">
                <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                    <h6><i class="fas fa-user"></i> Thông tin tài khoản</h6>
                </div>
                <div class="card-body px-4 pt-3 pb-2">
                    <form asp-action="UpdateProfile" method="post">
                        <input type="hidden" asp-for="ID_TaiKhoan" />

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label">Họ tên</label>
                                <input type="text" class="form-control form-control-sm" asp-for="hoTen" required>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Email</label>
                                <input type="email" class="form-control form-control-sm" asp-for="email" required>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Số điện thoại</label>
                                <input type="text" class="form-control form-control-sm" asp-for="soDienThoai" required>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Giới tính</label>
                                <select class="form-control form-control-sm" asp-for="gioiTinh">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Ngày sinh</label>
                                <input type="date" class="form-control form-control-sm" asp-for="ngaySinh">
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Trạng thái</label>
                                <input type="text" class="form-control form-control-sm" asp-for="trangThai" disabled>
                            </div>

                            <div class="col-md-6 mb-2">
                                <label class="form-label">Ngày tạo</label>
                                <input type="text" class="form-control form-control-sm" asp-for="ngayTao" disabled>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-save"></i> Lưu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
