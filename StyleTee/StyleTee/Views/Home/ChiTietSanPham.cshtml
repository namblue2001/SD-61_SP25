@model StyleTee.Models.SanPham
@{
    ViewData["Title"] = "ChiTietSanPham";
    Layout = "~/Views/Shared/_LayoutTrangChuKhachHang.cshtml";

    var popularProducts = ViewBag.PopularProducts as IEnumerable<StyleTee.Models.SanPham> ?? Enumerable.Empty<StyleTee.Models.SanPham>();
}

<div class="main">
    <div class="container">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")">Home</a></li>
            <li><a href="@Url.Action("Privacy", "Home")">Store</a></li>
            <li class="active">@Model.tenSanPham</li>
        </ul>
        <!-- BEGIN SIDEBAR & CONTENT -->
        <div class="row margin-bottom-40">
            <!-- BEGIN SIDEBAR -->
            <div class="sidebar col-md-3 col-sm-5">
                <ul class="list-group margin-bottom-25 sidebar-menu">
                    @if (Model.DanhMuc != null)
                    {
                        <li class="list-group-item clearfix">
                            <a href="@Url.Action("Privacy", "Home", new { categoryId = Model.DanhMuc.ID_DanhMuc })">
                                <i class="fa fa-angle-right"></i> @Model.DanhMuc.tenDanhMuc
                            </a>
                        </li>
                    }
                </ul>

                <div class="sidebar-products clearfix">
                    <h2>Bestsellers</h2>
                    @foreach (var product in popularProducts.Take(3))
                    {
                        <div class="item">
                            <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">
                                <img src="@(!string.IsNullOrEmpty(product.anhDaiDien) ? Url.Content(product.anhDaiDien) : Url.Content("~/LayoutKhachHang/theme/assets/pages/img/products/k1.jpg"))"
                                     alt="@product.tenSanPham">
                            </a>
                            <h3>
                                <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">@product.tenSanPham</a>
                            </h3>
                            <div class="price">@product.giaGoc.ToString("N0") đ</div>
                        </div>
                    }
                </div>
            </div>
            <!-- END SIDEBAR -->
            <!-- BEGIN CONTENT -->
            <div class="col-md-9 col-sm-7">
                <div class="product-page">
                    <div class="row">
                        <div class="col-md-6 col-sm-6">
                            <div class="product-main-image">
                                <img src="@(!string.IsNullOrEmpty(Model.anhDaiDien) ? Url.Content(Model.anhDaiDien) : Url.Content("~/LayoutKhachHang/theme/assets/pages/img/products/model7.jpg"))"
                                     alt="@Model.tenSanPham" class="img-responsive"
                                     data-BigImgsrc="@(!string.IsNullOrEmpty(Model.anhDaiDien) ? Url.Content(Model.anhDaiDien) : Url.Content("~/LayoutKhachHang/theme/assets/pages/img/products/model7.jpg"))">
                            </div>
                            <div class="product-other-images">
                                <a href="../LayoutKhachHang/theme/assets/pages/img/products/model3.jpg" class="fancybox-button" rel="photos-lib"><img alt="Berry Lace Dress" src="../LayoutKhachHang/theme/assets/pages/img/products/model3.jpg"></a>
                                <a href="../LayoutKhachHang/theme/assets/pages/img/products/model4.jpg" class="fancybox-button" rel="photos-lib"><img alt="Berry Lace Dress" src="../LayoutKhachHang/theme/assets/pages/img/products/model4.jpg"></a>
                                <a href="../LayoutKhachHang/theme/assets/pages/img/products/model5.jpg" class="fancybox-button" rel="photos-lib"><img alt="Berry Lace Dress" src="../LayoutKhachHang/theme/assets/pages/img/products/model5.jpg"></a>
                            </div>
                        </div>
                        <div class="col-md-6 col-sm-6">
                            <h1>@Model.tenSanPham</h1>
                            <div class="price-availability-block clearfix">
                                <div class="price">
                                    <strong><span>₫</span>@Model.giaGoc.ToString("N0")</strong>
                                </div>
                                <div class="availability">
                                    Availability: <strong>@(Model.trangThai == "Hoạt động" ? "In Stock" : "Out of Stock")</strong>
                                </div>
                            </div>
                            <div class="description">
                                <p>@Model.moTa</p>
                            </div>
                            <div class="product-page-options">
                                @if (Model.SanPhamChiTiet != null)
                                {
                                    <div class="pull-left" style="margin-right: 10px;">
                                        <label class="control-label">Size:</label>
                                        <select class="form-control input-sm" id="sizeSelect">
                                            <option value="">Chọn size</option>
                                            @foreach (var spct in Model.SanPhamChiTiet.Where(x => x.KichThuoc != null).Select(x => x.KichThuoc).Distinct())
                                            {
                                                <option value="@spct.ID_KichThuoc">@spct.tenKichThuoc</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="pull-left">
                                        <label class="control-label">Color:</label>
                                        <select class="form-control input-sm" id="colorSelect">
                                            <option value="">Chọn màu</option>
                                            @foreach (var spct in Model.SanPhamChiTiet.Where(x => x.MauSac != null).Select(x => x.MauSac).Distinct())
                                            {
                                                <option value="@spct.ID_MauSac">@spct.tenMauSac</option>
                                            }
                                        </select>
                                    </div>
                                }
                            </div>
                            <div class="product-page-cart">
                                <div class="product-quantity">
                                    <input id="product-quantity" type="text" value="1" readonly class="form-control input-sm">
                                </div>
                                <button class="btn btn-primary" type="submit">Add to cart</button>
                            </div>
                            <div class="review">
                                <input type="range" value="4" step="0.25" id="backing4">
                                <div class="rateit" data-rateit-backingfld="#backing4" data-rateit-resetable="false" data-rateit-ispreset="true" data-rateit-min="0" data-rateit-max="5">
                                </div>
                                <a href="javascript:;">7 reviews</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="javascript:;">Write a review</a>
                            </div>
                            <ul class="social-icons">
                                <li><a class="facebook" data-original-title="facebook" href="javascript:;"></a></li>
                                <li><a class="twitter" data-original-title="twitter" href="javascript:;"></a></li>
                                <li><a class="googleplus" data-original-title="googleplus" href="javascript:;"></a></li>
                                <li><a class="evernote" data-original-title="evernote" href="javascript:;"></a></li>
                                <li><a class="tumblr" data-original-title="tumblr" href="javascript:;"></a></li>
                            </ul>
                        </div>

                        <div class="product-page-content">
                            <ul id="myTab" class="nav nav-tabs">
                                <li class="active"><a href="#Description" data-toggle="tab">Description</a></li>
                                <li><a href="#Information" data-toggle="tab">Information</a></li>
                                <li><a href="#Reviews" data-toggle="tab">Reviews (2)</a></li>
                            </ul>
                            <div id="myTabContent" class="tab-content">
                                <div class="tab-pane fade in active" id="Description">
                                    <p>@Model.moTa</p>
                                </div>
                                <div class="tab-pane fade" id="Information">
                                    <table class="datasheet">
                                        <tr>
                                            <th colspan="2">Additional features</th>
                                        </tr>
                                        @if (Model.SanPhamChiTiet != null && Model.SanPhamChiTiet.Any())
                                        {
                                            var spct = Model.SanPhamChiTiet.First();
                                            if (spct.ChatLieu != null)
                                            {
                                                <tr>
                                                    <td class="datasheet-features-type">Material</td>
                                                    <td>@spct.ChatLieu.tenChatLieu</td>
                                                </tr>
                                            }
                                            if (spct.KieuDang != null)
                                            {
                                                <tr>
                                                    <td class="datasheet-features-type">Style</td>
                                                    <td>@spct.KieuDang.tenKieuDang</td>
                                                </tr>
                                            }
                                            if (spct.ThuongHieu != null)
                                            {
                                                <tr>
                                                    <td class="datasheet-features-type">Brand</td>
                                                    <td>@spct.ThuongHieu.tenThuongHieu</td>
                                                </tr>
                                            }
                                            if (spct.XuatXu != null)
                                            {
                                                <tr>
                                                    <td class="datasheet-features-type">Origin</td>
                                                    <td>@spct.XuatXu.tenXuatXu</td>
                                                </tr>
                                            }
                                        }
                                    </table>
                                </div>
                                <div class="tab-pane fade" id="Reviews">
                                    <!--<p>There are no reviews for this product.</p>-->
                                    <div class="review-item clearfix">
                                        <div class="review-item-submitted">
                                            <strong>Bob</strong>
                                            <em>30/12/2013 - 07:37</em>
                                            <div class="rateit" data-rateit-value="5" data-rateit-ispreset="true" data-rateit-readonly="true"></div>
                                        </div>
                                        <div class="review-item-content">
                                            <p>Sed velit quam, auctor id semper a, hendrerit eget justo. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Duis vel arcu pulvinar dolor tempus feugiat id in orci. Phasellus sed erat leo. Donec luctus, justo eget ultricies tristique, enim mauris bibendum orci, a sodales lectus purus ut lorem.</p>
                                        </div>
                                    </div>
                                    <div class="review-item clearfix">
                                        <div class="review-item-submitted">
                                            <strong>Mary</strong>
                                            <em>13/12/2013 - 17:49</em>
                                            <div class="rateit" data-rateit-value="2.5" data-rateit-ispreset="true" data-rateit-readonly="true"></div>
                                        </div>
                                        <div class="review-item-content">
                                            <p>Sed velit quam, auctor id semper a, hendrerit eget justo. Cum sociis natoque penatibus et magnis dis parturient montes, nascetur ridiculus mus. Duis vel arcu pulvinar dolor tempus feugiat id in orci. Phasellus sed erat leo. Donec luctus, justo eget ultricies tristique, enim mauris bibendum orci, a sodales lectus purus ut lorem.</p>
                                        </div>
                                    </div>

                                    <!-- BEGIN FORM-->
                                    <form action="#" class="reviews-form" role="form">
                                        <h2>Write a review</h2>
                                        <div class="form-group">
                                            <label for="name">Name <span class="require">*</span></label>
                                            <input type="text" class="form-control" id="name">
                                        </div>
                                        <div class="form-group">
                                            <label for="email">Email</label>
                                            <input type="text" class="form-control" id="email">
                                        </div>
                                        <div class="form-group">
                                            <label for="review">Review <span class="require">*</span></label>
                                            <textarea class="form-control" rows="8" id="review"></textarea>
                                        </div>
                                        <div class="form-group">
                                            <label for="email">Rating</label>
                                            <input type="range" value="4" step="0.25" id="backing5">
                                            <div class="rateit" data-rateit-backingfld="#backing5" data-rateit-resetable="false" data-rateit-ispreset="true" data-rateit-min="0" data-rateit-max="5">
                                            </div>
                                        </div>
                                        <div class="padding-top-20">
                                            <button type="submit" class="btn btn-primary">Send</button>
                                        </div>
                                    </form>
                                    <!-- END FORM-->
                                </div>
                            </div>
                        </div>

                        <div class="sticker sticker-sale"></div>
                    </div>
                </div>
            </div>
            <!-- END CONTENT -->
        </div>
        <!-- END SIDEBAR & CONTENT -->
        <!-- BEGIN SIMILAR PRODUCTS -->
        <div class="row margin-bottom-40">
            <div class="col-md-12 col-sm-12">
                <h2>Most popular products</h2>
                <div class="owl-carousel owl-carousel4">
                    @foreach (var product in popularProducts)
                    {
                        <div>
                            <div class="product-item">
                                <div class="pi-img-wrapper">
                                    <img src="@(!string.IsNullOrEmpty(product.anhDaiDien) ? Url.Content(product.anhDaiDien) : Url.Content("~/LayoutKhachHang/theme/assets/pages/img/products/k1.jpg"))"
                                         class="img-responsive" alt="@product.tenSanPham">
                                    <div>
                                        <a href="@(!string.IsNullOrEmpty(product.anhDaiDien) ? Url.Content(product.anhDaiDien) : Url.Content("~/LayoutKhachHang/theme/assets/pages/img/products/k1.jpg"))"
                                           class="btn btn-default fancybox-button">Zoom</a>
                                        <a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })"
                                           class="btn btn-default fancybox-fast-view">View</a>
                                    </div>
                                </div>
                                <h3><a href="@Url.Action("ChiTietSanPham", "Home", new { id = product.ID_SanPham })">@product.tenSanPham</a></h3>
                                <div class="pi-price">@product.giaGoc.ToString("N0") đ</div>
                                <a href="javascript:;" class="btn btn-default add2cart">Add to cart</a>
                                <div class="sticker sticker-new"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- END SIMILAR PRODUCTS -->
    </div>
</div>

<!-- BEGIN BRANDS -->
<div class="brands">
    <div class="container">
        <div class="owl-carousel owl-carousel6-brands">
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/canon.jpg" alt="canon" title="canon"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/esprit.jpg" alt="esprit" title="esprit"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/gap.jpg" alt="gap" title="gap"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/next.jpg" alt="next" title="next"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/puma.jpg" alt="puma" title="puma"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/zara.jpg" alt="zara" title="zara"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/canon.jpg" alt="canon" title="canon"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/esprit.jpg" alt="esprit" title="esprit"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/gap.jpg" alt="gap" title="gap"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/next.jpg" alt="next" title="next"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/puma.jpg" alt="puma" title="puma"></a>
            <a href="shop-product-list.html"><img src="../LayoutKhachHang/theme/assets/pages/img/brands/zara.jpg" alt="zara" title="zara"></a>
        </div>
    </div>
</div>
<!-- END BRANDS -->