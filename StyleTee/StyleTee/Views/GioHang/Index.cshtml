@model GioHangViewModel

<div class="container mt-5">
    <h2 class="text-center mb-4">🛒 Giỏ hàng của bạn</h2>

    @if (Model.ChiTietGioHang.Any())
    {
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-lg p-4 border-0">
                    <table class="table align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Hình ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ChiTietGioHang)
                            {
                                <tr class="border-bottom">
                                    <td>
                                        <img src="@item.AnhDaiDien" class="img-thumbnail" width="60" height="60">
                                    </td>
                                    <td><strong>@item.TenSanPham</strong></td>
                                    <td class="text-primary fw-bold">@item.DonGia.ToString("N0") đ</td>
                                    <td>
                                        <form method="post" asp-action="UpdateQuantity" asp-controller="GioHang" class="d-flex align-items-center">
                                            <input type="hidden" name="idSanPhamChiTiet" value="@item.ID_SanPhamChiTiet">
                                            <input type="number" name="soLuong" value="@item.SoLuong" min="1" class="form-control text-center mx-2" style="width: 70px;">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">✔</button>
                                        </form>
                                    </td>
                                    <td class="text-success fw-bold">@item.ThanhTien.ToString("N0") đ</td>
                                    <td>
                                        <form method="post" asp-action="RemoveFromCart" asp-controller="GioHang">
                                            <input type="hidden" name="idSanPhamChiTiet" value="@item.ID_SanPhamChiTiet">
                                            <button type="submit" class="btn btn-sm btn-danger">🗑</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Thông tin tổng tiền -->
            <div class="col-lg-4">
                <div class="card shadow-lg border-0 p-4">
                    <h4 class="text-center">🛍 Thông tin giỏ hàng</h4>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Tổng tiền:
                            <span class="fw-bold text-danger fs-5">@Model.TongTien.ToString("N0") đ</span>
                        </li>
                    </ul>
                    <div class="text-center mt-3">
                        <a href="/" class="btn btn-outline-primary w-100">🔙 Tiếp tục mua hàng</a>
                        <button class="btn btn-success w-100 mt-2">💳 Thanh toán</button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h5>Giỏ hàng trống 🛒</h5>
            <a href="/" class="btn btn-primary mt-3">Bắt đầu mua sắm</a>
        </div>
    }
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .table thead tr {
        background-color: #343a40;
        color: #fff;
    }

    .img-thumbnail {
        border-radius: 10px;
    }

    .btn-danger, .btn-success, .btn-primary {
        border-radius: 30px;
    }

        .btn-danger:hover {
            background-color: #dc3545;
            opacity: 0.8;
        }

    .shadow-lg {
        border-radius: 12px;
    }
</style>
