@model List<GioHangChiTiet>

<div class="container mt-4">
    <h2 class="mb-4 text-center">🛒 Giỏ Hàng Của Bạn</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th><input type="checkbox" id="select-all"></th>
                    <th>Sản Phẩm</th>
                    <th>Đơn Giá</th>
                    <th>Số Lượng</th>
                    <th>Thành Tiền</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="product-checkbox" data-id="@item.ID_GioHangChiTiet">
                        </td>
                        <td class="d-flex align-items-center">
                            <img src="~/images/@item.SanPhamChiTiet.anhDaiDien" class="img-thumbnail me-2" width="60">
                            <span>@item.SanPhamChiTiet.SanPham.tenSanPham</span>
                        </td>
                        <td class="donGia text-danger fw-bold">@item.donGia.ToString("N0") đ</td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center">
                                <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity('@item.ID_GioHangChiTiet', -1)">-</button>
                                <input type="text" class="form-control text-center mx-2 soLuong" value="@item.soLuong" style="width: 50px;" readonly>
                                <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity('@item.ID_GioHangChiTiet', 1)">+</button>
                            </div>
                        </td>
                        <td class="fw-bold thanhTien">@((item.soLuong * item.donGia).ToString("N0")) đ</td>
                        <td>
                            <a asp-action="XoaKhoiGio" asp-route-sanPhamChiTietId="@item.ID_GioHangChiTiet" class="btn btn-danger btn-sm">
                                🗑 Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <button class="btn btn-outline-danger btn-sm" onclick="removeSelected()">🗑 Xóa đã chọn</button>
            </div>
            <div class="fw-bold fs-5">
                Tổng tiền: <span id="tongTien" class="text-danger">0 đ</span>
            </div>
            <button onclick="thanhToan()" class="btn btn-success btn-lg">💳 Thanh Toán</button>
        </div>

        <div class="border p-3 rounded shadow-sm bg-white">
            <h5>🚚 Thông Tin Vận Chuyển</h5>
            <div class="mb-2">
                Phí vận chuyển: <span id="phiVanChuyen">--</span>
                <div id="shippingSpinner" class="spinner-border text-secondary d-none ms-2" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
            <div>
                Tổng thanh toán: <span id="tongThanhToan" class="fw-bold text-success fs-5">--</span>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h5>Giỏ hàng của bạn đang trống! 😢</h5>
            <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary">🛒 Mua sắm ngay</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQuantity(id, change) {
            let input = document.querySelector(`[data-id='${id}']`).closest('tr').querySelector(".soLuong");
            let newValue = Math.max(1, parseInt(input.value) + change);
            input.value = newValue;
            updateTotal();
        }

        function updateTotal() {
            let total = 0;
            document.querySelectorAll("tbody tr").forEach(row => {
                if (row.querySelector(".product-checkbox").checked) {
                    let price = parseInt(row.querySelector(".donGia").textContent.replace(/\D/g, ""));
                    let quantity = parseInt(row.querySelector(".soLuong").value);
                    total += price * quantity;
                    row.querySelector(".thanhTien").textContent = (price * quantity).toLocaleString() + " đ";
                }
            });
            document.getElementById("tongTien").textContent = total.toLocaleString() + " đ";
        }

        document.getElementById("select-all").addEventListener("change", function () {
            let checked = this.checked;
            document.querySelectorAll(".product-checkbox").forEach(cb => cb.checked = checked);
            updateTotal();
        });

        document.querySelectorAll(".product-checkbox").forEach(cb => {
            cb.addEventListener("change", updateTotal);
        });

        function removeSelected() {
            let selectedItems = document.querySelectorAll(".product-checkbox:checked");
            if (selectedItems.length === 0) {
                alert("Vui lòng chọn ít nhất một sản phẩm để xóa!");
                return;
            }
            if (confirm("Bạn có chắc muốn xóa các sản phẩm đã chọn?")) {
                selectedItems.forEach(item => {
                    let id = item.dataset.id;
                    window.location.href = `/GioHang/XoaKhoiGio?sanPhamChiTietId=${id}`;
                });
            }
        }

        function thanhToan() {
            let selectedItems = [];
            document.querySelectorAll(".product-checkbox:checked").forEach(cb => {
                selectedItems.push(cb.dataset.id);
            });

            if (selectedItems.length === 0) {
                alert("Vui lòng chọn ít nhất một sản phẩm để thanh toán!");
                return;
            }

            // Chuyển hướng đến trang xác nhận đơn hàng với danh sách sản phẩm đã chọn
            window.location.href = `/GioHang/XacNhanDonHang?selectedItems=${selectedItems.join(',')}`;
        }

        $(document).ready(function () {
            $('#shippingSpinner').removeClass('d-none');

            $.get('/DiaChi/GetDefaultAddress', function (response) {
                if (response.diaChi) {
                    $.get('/Shipping/CalculateFee', { diaChi: response.diaChi }, function (feeResp) {
                        if (!feeResp.error) {
                            $('#phiVanChuyen').text(feeResp.phiVanChuyen.toLocaleString('vi-VN') + ' đ');

                            let tamTinh = 0;
                            $(".product-checkbox:checked").each(function () {
                                let row = $(this).closest('tr');
                                let price = parseInt(row.find(".donGia").text().replace(/\D/g, ""));
                                let qty = parseInt(row.find(".soLuong").val());
                                tamTinh += price * qty;
                            });

                            let tongThanhToan = tamTinh + feeResp.phiVanChuyen;
                            $('#tongThanhToan').text(tongThanhToan.toLocaleString('vi-VN') + ' đ');
                        }
                        $('#shippingSpinner').addClass('d-none');
                    });
                } else {
                    $('#shippingSpinner').addClass('d-none');
                }
            });
        });
    </script>
}

<style>
    body {
        background-color: #f8f9fa;
    }

    .table thead tr {
        background-color: #343a40;
        color: #fff;
    }

    .img-thumbnail {
        border-radius: 10px;
    }

    .btn-danger, .btn-success, .btn-primary {
        border-radius: 30px;
    }

        .btn-danger:hover {
            background-color: #dc3545;
            opacity: 0.8;
        }

    .shadow-lg {
        border-radius: 12px;
    }
</style>
