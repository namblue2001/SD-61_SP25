@model List<GioHangChiTietViewModel>

<div class="container mt-4">
    <h2 class="mb-4 text-center">🛒 Giỏ Hàng Của Bạn</h2>

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered text-center align-middle">
            <thead class="table-dark">
                <tr>
                    <th><input type="checkbox" id="select-all"></th>
                    <th>Sản Phẩm</th>
                    <th>Đơn Giá</th>
                    <th>Số Lượng</th>
                    <th>Thành Tiền</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="product-checkbox" data-id="@item.ID_SanPhamChiTiet">
                        </td>
                        <td class="d-flex align-items-center">
                            <img src="~/images/@item.AnhDaiDien" class="img-thumbnail me-2" width="60">
                            <span>@item.TenSanPham</span>
                        </td>
                        <td class="text-danger fw-bold">@item.DonGia.ToString("N0") đ</td>
                        <td>
                            <div class="d-flex justify-content-center align-items-center">
                                <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity('@item.ID_SanPhamChiTiet', -1)">-</button>
                                <input type="text" class="form-control text-center mx-2" value="@item.SoLuong" style="width: 50px;" readonly>
                                <button class="btn btn-sm btn-outline-secondary" onclick="updateQuantity('@item.ID_SanPhamChiTiet', 1)">+</button>
                            </div>
                        </td>
                        <td class="fw-bold">@((item.SoLuong * item.DonGia).ToString("N0")) đ</td>
                        <td>
                            <a asp-action="XoaKhoiGio" asp-route-sanPhamChiTietId="@item.ID_SanPhamChiTiet" class="btn btn-danger btn-sm">
                                🗑 Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <button class="btn btn-outline-danger btn-sm" onclick="removeSelected()">🗑 Xóa đã chọn</button>
            </div>
            <div class="fw-bold fs-5">
                Tổng tiền: <span id="tongTien" class="text-danger">0 đ</span>
            </div>
            <a asp-controller="ThanhToan" asp-action="Index" class="btn btn-success btn-lg">💳 Thanh Toán</a>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center">
            <h5>Giỏ hàng của bạn đang trống! 😢</h5>
            <a asp-controller="SanPham" asp-action="Index" class="btn btn-primary">🛒 Mua sắm ngay</a>
        </div>
    }
</div>

<script>
    function updateQuantity(id, change) {
        let input = document.querySelector(`[data-id='${id}']`).closest('tr').querySelector("input[type='text']");
        let newValue = Math.max(1, parseInt(input.value) + change);
        input.value = newValue;
        updateTotal();
    }

    function updateTotal() {
        let total = 0;
        document.querySelectorAll("tbody tr").forEach(row => {
            let isChecked = row.querySelector(".product-checkbox").checked;
            if (isChecked) {
                let price = parseInt(row.querySelector(".text-danger").textContent.replace(/\D/g, ""));
                let quantity = parseInt(row.querySelector("input[type='text']").value);
                total += price * quantity;
            }
        });
        document.getElementById("tongTien").textContent = total.toLocaleString() + " đ";
    }

    document.getElementById("select-all").addEventListener("change", function () {
        let checked = this.checked;
        document.querySelectorAll(".product-checkbox").forEach(cb => cb.checked = checked);
        updateTotal();
    });

    document.querySelectorAll(".product-checkbox").forEach(cb => {
        cb.addEventListener("change", updateTotal);
    });

    function removeSelected() {
        let selectedItems = document.querySelectorAll(".product-checkbox:checked");
        if (selectedItems.length === 0) {
            alert("Vui lòng chọn ít nhất một sản phẩm để xóa!");
            return;
        }
        if (confirm("Bạn có chắc muốn xóa các sản phẩm đã chọn?")) {
            selectedItems.forEach(item => {
                let id = item.dataset.id;
                window.location.href = `/GioHang/XoaKhoiGio?sanPhamChiTietId=${id}`;
            });
        }
    }
</script>
